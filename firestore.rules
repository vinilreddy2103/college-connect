rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isCollegeAdmin() {
      return isAuthenticated() && getUserData().role == 'collegeAdmin';
    }
    
    function isEventOrganizer(eventId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin() || (
        isCollegeAdmin() && 
        // College admin can only update users in their college
        resource.data.collegeId == getUserData().collegeId &&
        // And can only update role field
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
      );
      allow delete: if isAdmin();
      
      // User registrations subcollection
      match /registrations/{eventId} {
        allow read, write: if isOwner(userId);
      }
      
      // User activities subcollection (for activity timeline)
      match /activities/{activityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuthenticated(); // Any user can create notifications for others (likes, comments, etc.)
        allow update: if isOwner(userId); // Only owner can mark as read
      }
    }

    // Colleges collection
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isEventOrganizer(eventId) || 
        isCollegeAdmin() || 
        isAdmin() ||
        // Allow like/comment count and registration count updates from authenticated users
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'registrationCount']))
      );
      allow delete: if isCollegeAdmin() || isAdmin();
      
      // Event registrations subcollection
      match /registrations/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
      }
      
      // Event likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
      
      // Event comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          // Comment author can delete their own comments
          resource.data.userId == request.auth.uid ||
          // Event organizer can delete any comment on their event
          isEventOrganizer(eventId) ||
          // College admin or admin can delete any comment
          isCollegeAdmin() ||
          isAdmin()
        );
      }
      
      // Event payments subcollection
      match /payments/{paymentId} {
        allow read: if isAuthenticated() && (
          // User can read their own payment
          resource.data.userId == request.auth.uid ||
          // Event organizer can read all payments
          isEventOrganizer(eventId) ||
          // Admin/College admin can read all
          isCollegeAdmin() ||
          isAdmin()
        );
        // Any authenticated user can create a payment (for their own order)
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          // User can update their own payment (for completing payment)
          resource.data.userId == request.auth.uid ||
          // Organizer/admin can update (for refunds)
          isEventOrganizer(eventId) ||
          isCollegeAdmin() ||
          isAdmin()
        );
      }
    }
    
    // User payments subcollection (for payment history)
    match /users/{userId}/payments/{paymentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }
    
    // User clubs subcollection (clubs user has joined)
    match /users/{userId}/clubs/{clubId} {
      allow read: if isAuthenticated();
      // Allow owner or club coordinator/leader to write (for approvals)
      allow write: if isOwner(userId) || (isAuthenticated() && (
        get(/databases/$(database)/documents/clubs/$(clubId)).data.facultyCoordinatorId == request.auth.uid ||
        get(/databases/$(database)/documents/clubs/$(clubId)).data.leaderId == request.auth.uid
      ));
    }

    // Clubs collection
    match /clubs/{clubId} {
      // Helper to get club data
      function getClubData() {
        return get(/databases/$(database)/documents/clubs/$(clubId)).data;
      }
      
      // Helper to check if user is club leader or coordinator
      function isClubLeader() {
        return isAuthenticated() && 
               resource.data.leaderId == request.auth.uid;
      }
      
      function isClubCoordinator() {
        return isAuthenticated() && 
               resource.data.facultyCoordinatorId == request.auth.uid;
      }
      
      // For subcollections - check parent club
      function isClubLeaderFromParent() {
        return isAuthenticated() && 
               getClubData().leaderId == request.auth.uid;
      }
      
      function isClubCoordinatorFromParent() {
        return isAuthenticated() && 
               getClubData().facultyCoordinatorId == request.auth.uid;
      }
      
      allow read: if true;
      allow create: if isAuthenticated() && (isCollegeAdmin() || getUserData().role == 'faculty');
      allow update: if isAuthenticated() && (
        isClubLeader() || 
        isClubCoordinator() || 
        isCollegeAdmin() || 
        isAdmin() ||
        // Allow member count updates
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']))
      );
      allow delete: if isCollegeAdmin() || isAdmin();
      
      // Club members subcollection
      match /members/{userId} {
        allow read: if isAuthenticated();
        // Allow self-join OR coordinator/leader can add members (for approvals)
        allow create: if isOwner(userId) || isClubLeaderFromParent() || isClubCoordinatorFromParent() || isCollegeAdmin();
        allow update: if isOwner(userId) || isClubLeaderFromParent() || isClubCoordinatorFromParent() || isCollegeAdmin();
        allow delete: if isOwner(userId) || isClubLeaderFromParent() || isClubCoordinatorFromParent() || isCollegeAdmin();
      }
      
      // Club payments subcollection (for paid memberships)
      match /payments/{paymentId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isClubLeaderFromParent() ||
          isClubCoordinatorFromParent() ||
          isCollegeAdmin() ||
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isClubLeaderFromParent() ||
          isClubCoordinatorFromParent() ||
          isCollegeAdmin()
        );
      }
      
      // Club join requests subcollection (for approval-required clubs)
      match /joinRequests/{requestId} {
        allow read: if isAuthenticated() && (
          // User can read their own request
          resource.data.userId == request.auth.uid ||
          // Club leadership can read all
          isClubLeaderFromParent() ||
          isClubCoordinatorFromParent() ||
          isCollegeAdmin() ||
          isAdmin()
        );
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          isClubLeaderFromParent() ||
          isClubCoordinatorFromParent() ||
          isCollegeAdmin()
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isClubLeaderFromParent() ||
          isClubCoordinatorFromParent() ||
          isCollegeAdmin()
        );
      }
    }
    
    // Fests collection
    match /fests/{festId} {
      allow read: if true; // Anyone can view fests
      allow create: if isAuthenticated() && isCollegeAdmin();
      allow update: if isAuthenticated() && (
        isCollegeAdmin() && resource.data.collegeId == getUserData().collegeId
      );
      allow delete: if isAuthenticated() && (
        isCollegeAdmin() && resource.data.collegeId == getUserData().collegeId
      );
    }
    
    // Admin Invites collection (Super Admin only)
    match /adminInvites/{inviteId} {
      // Anyone can read to verify token (for setup page)
      allow read: if true;
      // Only super admin can create/update/delete
      allow create, update, delete: if isAdmin();
    }
    
    // Audit Logs collection (Super Admin only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      // No update/delete - logs are immutable
    }
  }
}
